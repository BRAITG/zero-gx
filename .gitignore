.godot/
/build/
*.apk
*.idsig
godot/

# Android Gradle build template, installed by the export (see docs/release/google-play.md); the plugin sources in android/plugins are tracked
/android/*
!/android/plugins/
/android/plugins/*/.gradle/
/android/plugins/*/build/
/android/plugins/*/local.properties

# Community server
/server/node_modules/
/server/.wrangler/
/server/.dev.vars

# Graphify: only the graph is tracked (see tools/setup-hooks.sh); its cache and reports stay local.
# .gdignore keeps Godot from importing or exporting the graph.
/graphify-out/*
!/graphify-out/graph.json
!/graphify-out/.gdignore
